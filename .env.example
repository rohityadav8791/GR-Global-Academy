# GR Global Academy - Environment Variables
# Copy this file to .env and replace the placeholder values with your actual credentials.
# Never commit .env to version control. Add it to .gitignore.

# Resend API Key - Get it from https://resend.com/api-keys
# Never expose this in frontend code; it is used only by the server.
RESEND_API_KEY=re_your_api_key_here

# Recipient email address where admission enquiries are sent
ADMISSION_EMAIL=your-school-email@example.com

# Sender email address (must be a verified domain or email in Resend)
# Use a verified sender like admissions@yourdomain.com
RESEND_FROM_EMAIL=verified-sender@yourdomain.com

# Server port (optional, default 3001)
PORT=3001

# Vite dev server port (optional, default 5173)
VITE_PORT=5173
